{
  "id": "sanna",
  "name": "Sanna Governance",
  "version": "0.1.0",
  "description": "Constitution enforcement and cryptographic receipts for OpenClaw agents",
  "skills": ["skills/sanna-governance"],
  "configSchema": {
    "type": "object",
    "properties": {
      "constitutionPath": { "type": "string", "description": "Path to YAML constitution" },
      "signingKeyPath": { "type": "string", "description": "Path to Ed25519 signing key" },
      "publicKeyPath": { "type": "string", "description": "Path to Ed25519 public key" },
      "receiptStorePath": { "type": "string", "description": "Path to SQLite receipt database" },
      "sidecarPort": { "type": "number", "default": 18791 },
      "sidecarHost": { "type": "string", "default": "127.0.0.1" },
      "pythonPath": { "type": "string", "description": "Python 3.10+ binary (auto-detected if not set)" },
      "governedTools": {
        "type": "array",
        "items": { "type": "string" },
        "default": ["exec", "write", "edit", "apply_patch", "browser_navigate", "browser_click"]
      }
    }
  }
}
