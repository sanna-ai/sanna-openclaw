{
  "name": "@sanna-ai/openclaw",
  "version": "1.0.2",
  "description": "OpenClaw plugin that enforces Sanna governance constitutions on AI agent tool execution",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.1.26",
      "minGatewayVersion": "2026.1.26"
    },
    "build": {
      "openclawVersion": "2026.1.26",
      "pluginSdkVersion": "2026.1.26"
    }
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "constitutions/**/*",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "sanna",
    "openclaw",
    "governance",
    "ai-safety",
    "constitution"
  ],
  "author": "Nic Allen <nic@sanna.dev>",
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@opentelemetry/api": ">=1.0.0",
    "openclaw": ">=2026.1.26"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@sanna-ai/core": "^1.0.0"
  }
}
